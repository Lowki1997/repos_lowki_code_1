class User:
    """
    Base class for all instances in the database.
    Contains all required args for the database.
    name, email, phonenum are required for this class 
    """ 

    def __init__(self, name, email, phonenum):
        self.name = name
        self.email = email
        self.phonenum = phonenum
   
    #Name Property
    @property
    def name(self):
        return self._name
   
    @name.setter
    def name(self, value):
        self._name = value
   
    #Email Property
    @property
    def email(self):
        return self._email
   
    @email.setter
    def email(self, value):
        self._email = value

    #phonenum Property
    @property
    def phonenum(self):
        return self._phonenum
   
    @phonenum.setter
    def phonenum(self, value):
        self._phonenum = value

   
        
class Employee(User):
   """
   Employee class inherits from User class
   Used for normal workers in the database
   Takes in all required args from User class and adds office arg
   """

   def __init__(self, name, email, phonenum, office):
        super().__init__(name, email, phonenum)
        self.role = "Employee"
        self.office = office
     
   #office Property
   @property
   def office(self):
           return self._office
   
   @office.setter
   def office(self, value):
          self._office = value
     

class Admin(Employee):
    """
    Admin class inherits from Employee class
    Used for Admin workers in the database
    Takes in all required args from Employee class and adds admin_level arg
    """

    def __init__(self, name, email, phonenum, office, admin_level):
        super().__init__(name, email, phonenum)
        self.role = "Admin"
        self.office = office
        self.admin_level = admin_level

     #Admin_level Property
    @property
    def admin_level(self):
           return self._admin_level
    
    @admin_level.setter
    def admin_level(self, value):
          self._admin_level = value
    

